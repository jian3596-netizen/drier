{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "T5L51: Build (SDCC)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/SCREEN_APP/T5L51/build.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      "label": "T5L51: Build + update DWIN_SET",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/SCREEN_APP/T5L51/build.ps1",
        "-UpdateDwinSet"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": "build"
    }
  ]
}
